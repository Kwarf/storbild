{
  "name": "storbild",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "bun --watch packages/server/src/main.ts",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "hash-password": "bun packages/server/src/cli.ts hash-password",
    "demo": "bun packages/server/demo/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
