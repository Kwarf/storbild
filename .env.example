# Storbild configuration. Every variable is optional; defaults are shown.
# Bun loads .env automatically when running `bun run dev`.

# Bind address for both apps. Keep it on loopback when running behind Caddy.
STORBILD_HOST=127.0.0.1

# Viewer app (screen hostname) and admin app (admin hostname). Must differ.
STORBILD_VIEWER_PORT=3000
STORBILD_ADMIN_PORT=3001

# SQLite database and uploaded assets live here.
STORBILD_DATA_DIR=./data

# Single admin user. The password hash is required: generate it with `bun run hash-password`.
# Bun expands `$` in .env even inside quotes, so write each `$` as `\$`; the command prints
# the line ready to paste.
STORBILD_ADMIN_USERNAME=admin
STORBILD_ADMIN_PASSWORD_HASH=

# The largest file that can be uploaded as an asset, in MB.
STORBILD_MAX_UPLOAD_MB=25

# The largest video that can be uploaded, in MB. Uploads are streamed to disk.
STORBILD_MAX_VIDEO_UPLOAD_MB=200

# The largest show file (an exported .zip with all its assets) that can be imported, in MB.
STORBILD_MAX_IMPORT_MB=4096

# Extra plugin directories, separated by the OS path delimiter (":" on Linux/macOS).
STORBILD_PLUGIN_PATHS=

# Reload plugins from STORBILD_PLUGIN_PATHS when their files change, for plugin development.
# Leave it off for a show (ADR 0025).
STORBILD_PLUGIN_WATCH=false

# Public URLs as seen through the reverse proxy.
STORBILD_VIEWER_URL=http://localhost:3000
STORBILD_ADMIN_URL=http://localhost:3001
