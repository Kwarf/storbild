{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    // The SDK ships TypeScript sources until it is published with a build (M10).
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
