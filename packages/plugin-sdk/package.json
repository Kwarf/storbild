{
  "name": "@storbild/plugin-sdk",
  "version": "1.2.0",
  "description": "Write plugins for Storbild, the big-screen software for demoparties",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kwarf/storbild.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/Kwarf/storbild/blob/main/docs/plugin-authoring.md",
  "keywords": [
    "storbild",
    "demoparty",
    "plugin",
    "lit"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./viewer": "./src/viewer.ts",
    "./admin": "./src/admin.ts",
    "./build": "./src/build.ts"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@storbild/core": "workspace:*"
  },
  "peerDependencies": {
    "lit": "^3.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "lit": "3.3.3",
    "zod": "4.6.5"
  }
}
