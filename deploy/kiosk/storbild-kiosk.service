# The Storbild screen: cage, a Wayland kiosk compositor, running Chromium on tty1 as the
# `kiosk` user (ADR 0027). Installed by setup.sh.

[Unit]
Description=Storbild kiosk
Documentation=https://github.com/Kwarf/storbild/blob/main/docs/deployment.md
After=systemd-user-sessions.service plymouth-quit-wait.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/cage -d -- /usr/local/lib/storbild-kiosk/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
