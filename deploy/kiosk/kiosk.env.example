# The Storbild kiosk's configuration, at /etc/storbild-kiosk.env (readable by root and the
# kiosk user only). The screen host is behind basic auth, so the URL carries the user and
# password Caddy expects (ADR 0027). Percent-encode special characters in the password.
STORBILD_SCREEN_URL=https://screen:CHANGE-ME@screen.party.example.org/
